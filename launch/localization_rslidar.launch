<launch>
<!-- RS-LiDAR pure localization against a prebuilt Point-LIO PCD map. -->

	<arg name="rviz" default="true" />
	<arg name="map_path" default="$(find point_lio)/PCD/scans.pcd" />
	<arg name="map_voxel_size" default="0.5" />
	<arg name="publish_map" default="true" />
	<arg name="init_source" default="rviz" />
	<arg name="initial_pose_topic" default="/initialpose" />
	<arg name="wait_for_initial_pose" default="true" />
	<arg name="init_x" default="0.0" />
	<arg name="init_y" default="0.0" />
	<arg name="init_z" default="0.0" />
	<arg name="init_roll" default="0.0" />
	<arg name="init_pitch" default="0.0" />
	<arg name="init_yaw" default="0.0" />
	<arg name="ivox_capacity" default="2000000" />

	<node pkg="point_lio" type="pointlio_mapping" name="laserMapping" output="screen">
	<rosparam command="load" file="$(find point_lio)/config/rslidar.yaml" />
	<param name="use_imu_as_input" type="bool" value="0"/>
	<param name="prop_at_freq_of_imu" type="bool" value="1"/>
	<param name="check_satu" type="bool" value="1"/>
	<param name="init_map_size" type="int" value="10"/>
	<param name="point_filter_num" type="int" value="4"/>
	<param name="space_down_sample" type="bool" value="1" />
	<param name="filter_size_surf" type="double" value="0.5" />
	<param name="filter_size_map" type="double" value="0.5" />
	<param name="ivox_nearby_type" type="int" value="6" />
	<param name="runtime_pos_log_enable" type="bool" value="0" />

	<param name="localization/enable" type="bool" value="true" />
	<param name="localization/map_path" type="string" value="$(arg map_path)" />
	<param name="localization/map_voxel_size" type="double" value="$(arg map_voxel_size)" />
	<param name="localization/publish_map" type="bool" value="$(arg publish_map)" />
	<param name="localization/init_source" type="string" value="$(arg init_source)" />
	<param name="localization/initial_pose_topic" type="string" value="$(arg initial_pose_topic)" />
	<param name="localization/wait_for_initial_pose" type="bool" value="$(arg wait_for_initial_pose)" />
	<param name="localization/init_x" type="double" value="$(arg init_x)" />
	<param name="localization/init_y" type="double" value="$(arg init_y)" />
	<param name="localization/init_z" type="double" value="$(arg init_z)" />
	<param name="localization/init_roll" type="double" value="$(arg init_roll)" />
	<param name="localization/init_pitch" type="double" value="$(arg init_pitch)" />
	<param name="localization/init_yaw" type="double" value="$(arg init_yaw)" />
	<param name="mapping/ivox_capacity" type="int" value="$(arg ivox_capacity)" />
	</node>

	<group if="$(arg rviz)">
	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find point_lio)/rviz_cfg/loam_livox.rviz" />
	</group>
</launch>
